{
  "name": "rust-book-narrated",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Astro/Starlight companion site for The Rust Programming Language (Brown CS 'quizzed' edition), with a Kokoro-JS narrator and original per-chapter exercises. Book text + quizzes are cloned and transformed at build time — nothing is vendored. See ATTRIBUTION.md.",
  "scripts": {
    "fetch-book": "node scripts/fetch-book.mjs",
    "check-vocabulary": "node scripts/check-vocabulary.mjs",
    "prebuild": "npm run fetch-book && npm run check-vocabulary",
    "dev": "npm run prebuild && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "narrate": "node scripts/narrate.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.30.0",
    "astro": "^5.0.0",
    "sharp": "^0.33.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "smol-toml": "^1.8.0",
    "ffmpeg-static": "^5.2.0",
    "hast-util-from-html": "^2.0.3",
    "kokoro-js": "^1.2.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true
  }
}
