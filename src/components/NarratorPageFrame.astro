---
// Starlight component override (see astro.config.mjs `components.Footer`).
// Footer is the documented override point for appending content below the
// article body — used here only for the recall quiz. The narration player
// mounts from PageTitle.astro instead (right under the title, above the
// content), matching zed-rust-for-dummies's split between the two override
// points. It renders Starlight's own Footer underneath, unchanged.
import Default from "@astrojs/starlight/components/Footer.astro";
import RecallQuiz from "./RecallQuiz.astro";

// Starlight passes the full route data (StarlightRouteData) as Astro.props
// to every overridable component — see @astrojs/starlight/props.ts and how
// Footer.astro itself reads Astro.props.entry. (Astro.locals.starlightRoute
// does NOT carry this in 0.30 — checked against node_modules directly
// after the first attempt silently rendered no quiz.)
const id = Astro.props.entry?.id ?? "";
const slug = id.startsWith("book/") ? id.replace(/^book\//, "").replace(/\/$/, "") : null;
---

{slug && <RecallQuiz slug={slug} />}
<Default {...Astro.props} />
